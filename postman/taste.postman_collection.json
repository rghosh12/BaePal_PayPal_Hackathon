{
  "info": {
    "name": "BaePal synthetic taste regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Isolated loopback Worker harness only. Fictional data; no PayPal history or payment evidence. Run pnpm test:postman. Never target the deployed Site with test-owner headers."
  },
  "item": [
    {
      "name": "Login as fictional Alex",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:4173"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{session_cookie}}"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          },
          {
            "key": "x-baepal-test-owner",
            "value": "{{owner}}"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"alex@demo.baepal.invalid\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"csrf\", pm.response.json().data.csrf);",
              "pm.environment.set(\"session_cookie\", pm.response.headers.get(\"set-cookie\").split(\";\")[0]);"
            ]
          }
        }
      ]
    },
