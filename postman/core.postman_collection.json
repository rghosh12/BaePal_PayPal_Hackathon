{
  "info": {
    "name": "BaePal synthetic core/payment regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Actual Newman execution against an isolated loopback original API and randomly scoped PostgreSQL schema. Fictional data and mock provider only; no Sandbox claim. Run pnpm test:postman:core."
  },
  "item": [
    {
      "name": "Anonymous receipt denied",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{app_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": ""
          },
          {
            "key": "x-csrf-token",
            "value": ""
          }
        ],
        "url": "{{base_url}}/api/v1/payments/{{foreign_payment_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
