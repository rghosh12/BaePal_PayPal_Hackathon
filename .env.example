DATABASE_URL=postgres://baepal:local_only@127.0.0.1:5432/baepal
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
PORT=4000
SESSION_SECRET=replace_with_at_least_32_random_characters
FIELD_ENCRYPTION_KEY=replace_with_64_hex_characters
# Old field-encryption keys (comma-separated hex) still accepted for decryption.
# Rotate: move the old key here, set a new FIELD_ENCRYPTION_KEY, run `pnpm keys:rotate`.
FIELD_ENCRYPTION_PREVIOUS_KEYS=
# Email: "local" writes .data/mail/*.json; "resend" sends through Resend (needs EMAIL_API_KEY).
EMAIL_MODE=local
EMAIL_FROM=demo@baepal.invalid
EMAIL_API_KEY=
# Photo moderation: "auto" (labelled auto-approval) or "manual" (moderator queue).
MEDIA_MODERATION=auto
# Optional Planning Pass price in cents (Sandbox only).
PLANNING_PASS_CENTS=500
# Retention windows in days (hourly purge job).
RETENTION_CLOSED_CHAT_DAYS=365
RETENTION_NOTIFICATION_DAYS=180
RETENTION_EMAIL_DAYS=30
RETENTION_WEBHOOK_DAYS=90
# PayPal: "mock" (no PayPal calls) or "sandbox" (real PayPal Sandbox, test money only).
# Sandbox needs a REST app from developer.paypal.com → Apps & Credentials (Sandbox).
# PAYPAL_MERCHANT_ID = the Sandbox *business* account's Merchant ID (Account info).
# PAYPAL_WEBHOOK_ID is optional; webhooks are rejected until it is configured.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
DEMO_MODE=true
# AI: "deterministic" (labeled fallback, no model) or "openai" (any OpenAI-compatible API).
# OpenAI:  AI_BASE_URL=https://api.openai.com/v1                              AI_MODEL=gpt-4o-mini
# Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.5-flash
# Groq:    AI_BASE_URL=https://api.groq.com/openai/v1                         AI_MODEL=llama-3.3-70b-versatile
AI_MODE=deterministic
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=15000
# Optional profile connections. OAuth callback: <APP_ORIGIN>/api/v1/auth/github/callback
# (and .../auth/linkedin/callback). Leave blank to hide the option.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-only integration hub. Paste a single-line JSON value from the
# integrations/config.example.json template into your secret environment.
# No NEXT_PUBLIC_ prefix. Hosted Sites use the same named runtime secret.
BAEPAL_INTEGRATIONS_JSON=

# Fastify trustProxy: loopback locally (web proxy on same machine); true behind Render.
TRUST_PROXY=loopback
